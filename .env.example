# PocketBridge Configuration
PORT=3000
HOST=0.0.0.0

# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional Web PIN protection for your local Wi-Fi interface (leave blank to disable)
ACCESS_PIN=

# Optional Telegram Credentials (if sending messages from your personal Telegram account)
# Obtain API_ID and API_HASH from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
